# Copy this file to .env for local development. Never commit the real .env —
# it's already in .gitignore. In production (Vercel), set these as real
# Environment Variables in the project dashboard instead of a file.

# MySQL connection string. Format: mysql://user:password@host:port/database
# Local dev: see scripts/setup-local-db.sql
# Production: use your hosted MySQL provider's connection string (PlanetScale,
# Railway, Aiven, etc. all provide one in this format).
DATABASE_URL=mysql://portfolio_dev:CHANGE_ME@localhost:3306/portfolio_dev

# The single admin's login username (not secret, but keep it non-obvious).
ADMIN_USERNAME=mubarak

# The admin password's hash — never the plaintext password itself. Generate
# this by running `npm run hash-password` locally and pasting its output here.
ADMIN_PASSWORD_HASH=

# Random secret used to sign admin session cookies. Generate a strong one
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Set automatically by Vercel in production — only needed locally if you want
# to test production-only behavior (e.g. the Secure cookie flag).
NODE_ENV=development

# Only used by scripts/test-api.js so it can log in during the automated
# test run. Never used by the deployed app itself — leave unset in
# production, or just don't run the test script there.
TEST_ADMIN_PASSWORD=
